PORT=9292

# Postgres (Neon pooled URL in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

JWT_SECRET="change-me-min-8-chars"
JWT_REFRESH_SECRET="change-me-refresh-min-8"
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# local = filesystem; r2 = Cloudflare R2 (production on Render)
STORAGE_BACKEND=local
STORAGE_ROOT="../../storage"

# Cloudflare R2 (required when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Set to eu/fedramp only for jurisdiction-locked buckets; leave empty for default
R2_JURISDICTION=""

# Comma-separated origins (production example below)
CORS_ORIGIN="http://localhost:5173"
# CORS_ORIGIN="https://fiscorai.com,https://www.fiscorai.com"

# Lemon Squeezy (live in production)
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_VARIANT_BASIC=""
LEMONSQUEEZY_VARIANT_STANDARD=""
LEMONSQUEEZY_VARIANT_PRO=""

PAYMENT_SUCCESS_URL="http://localhost:5173/thankyou"
PAYMENT_CANCEL_URL="http://localhost:5173/payment-failed"
# PAYMENT_SUCCESS_URL="https://fiscorai.com/thankyou"
# PAYMENT_CANCEL_URL="https://fiscorai.com/payment-failed"

GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=""

# Public web URL used in confirmation / password-reset email links
WEB_APP_URL="http://localhost:5173"
# WEB_APP_URL="https://fiscorai.com"

# Transactional email (GoDaddy Professional Email / Titan)
# Official SMTP: smtpout.secureserver.net:465 SSL
EMAIL_FROM="FiscorAI <support@fiscorai.com>"
# Prefer Resend in production (GoDaddy SMTP often times out from Render)
RESEND_API_KEY=""
EMAIL_NOTIFY_TO="sanaullahbugti821@gmail.com"
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="support@fiscorai.com"
SMTP_PASS=""
