{
  "name": "fiscorai",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter @fiscorai/tax-processor --filter @fiscorai/api --filter @fiscorai/web dev",
    "dev:api": "pnpm --filter @fiscorai/api dev",
    "dev:web": "pnpm --filter @fiscorai/web dev",
    "dev:processor": "pnpm --filter @fiscorai/tax-processor dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test && pnpm test:e2e",
    "db:push": "pnpm --filter @fiscorai/api db:push",
    "db:generate": "pnpm --filter @fiscorai/api db:generate",
    "db:migrate": "pnpm --filter @fiscorai/api db:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
